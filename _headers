# Cloudflare Pages static-asset headers.
# Docs: https://developers.cloudflare.com/pages/platform/headers/

# --- security baseline (every response) ---
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# --- HTML: always revalidate so edits ship immediately ---
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# --- static assets: 7 days, stale-while-revalidate ---
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# --- code must ship fast ---
# JS and CSS keep the same URL across deploys, so a 7-day browser cache would
# keep serving yesterday's bug for a week. Five minutes is long enough to save
# repeat downloads and short enough that a fix is visible on the next visit.
# These come last so they override the rule above.
/assets/*.js
  Cache-Control: public, max-age=300, must-revalidate

/assets/*.css
  Cache-Control: public, max-age=300, must-revalidate

# --- API: never cache ---
/api/*
  Cache-Control: no-store
