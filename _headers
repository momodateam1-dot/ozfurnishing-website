# Cloudflare Pages static-asset headers.
# Docs: https://developers.cloudflare.com/pages/platform/headers/

# --- security baseline (every response) ---
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# --- HTML: always revalidate so edits ship immediately ---
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# --- static assets: 7 days, stale-while-revalidate ---
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# --- API: never cache ---
/api/*
  Cache-Control: no-store
