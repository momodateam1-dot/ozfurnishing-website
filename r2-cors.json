{
  "comment": "Paste into R2 bucket oz-assets > Settings > CORS Policy. Allows the site to read public assets from cdn.ozfurnishing.com.",
  "rules": [
    {
      "AllowedOrigins": [
        "https://ozfurnishing.com",
        "https://www.ozfurnishing.com"
      ],
      "AllowedMethods": ["GET", "HEAD"],
      "AllowedHeaders": ["*"],
      "ExposeHeaders": ["Content-Length", "Content-Type", "ETag"],
      "MaxAgeSeconds": 86400
    }
  ]
}
